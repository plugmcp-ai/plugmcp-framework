{
  "name": "plugmcp",
  "version": "0.1.0",
  "description": "The framework for building MCP servers and MCP apps. Local Studio with a canvas, schema-first tool testing, a chat that builds tools with your own key, and the PlugMCP directory built in.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://plugmcp.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plugmcp-ai/sdk.git",
    "directory": "packages/plugmcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-apps",
    "mcp-ui",
    "claude",
    "chatgpt",
    "agent",
    "ai",
    "sdk",
    "cli",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "plugmcp": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "studio-dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "node -e \"const fs=require('fs');fs.copyFileSync('../../README.md','README.md');fs.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/openai": "^4.0.121",
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ai": "^7.0.177",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.328",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
